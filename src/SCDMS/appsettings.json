{
  "SCDMS": {
    "BindAddress": "localhost",
    "HttpsPort": 5443,
    "HttpPort": 8080,
    "EnableHttps": true,
    "UseForwardedHeaders": false,
    "DataDirectory": "",
    "QueryTimeoutSeconds": 30,
    "ResultRowLimit": 200,
    "MaxRecentConnections": 8,
    "DefaultDatabaseName": "scdb",
    "DefaultDatabasePath": "",
    "SampleDatabasesDirectory": "",
    "DefaultServerHost": "",
    "DefaultServerPort": 5001,
    "DefaultServerDatabase": "master",
    "DefaultServerUsername": "anonymous",
    "DefaultServerPassword": "",
    "DefaultServerUseSsl": true,
    "DefaultServerPreferHttp3": true,
    "DefaultServerAutoConnect": false,
    "UpdateCheckEnabled": true,
    "GitHubRepository": "MPCoreDeveloper/SCDMS"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
