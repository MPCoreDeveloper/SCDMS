# ── Domains (must resolve publicly for automatic Let's Encrypt certificates) ──
SCDMS_DOMAIN=scdms.example.com
GRPC_DOMAIN=scdb.example.com
ACME_EMAIL=admin@example.com

# ── SharpCoreDB server credentials ──
# Place the server's TLS PFX (or cert+key) in ./server-certs and set the path.
SERVER_TLS_CERT_PATH=/app/certs/server.pfx
SERVER_JWT_SECRET=replace-with-a-random-32-char-secret

# ── SCDMS default-server login used against the SharpCoreDB server ──
SDB_USERNAME=anonymous
SDB_PASSWORD=
